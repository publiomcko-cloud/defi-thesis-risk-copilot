{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defi-thesis-risk-copilot.invalid/schemas/phase-20-event-definition.json",
  "title": "Phase 20A candidate product analytics event definition",
  "description": "Documentation schema only. It does not enable runtime collection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "schema_version",
    "purpose",
    "trigger",
    "actor_scopes",
    "metadata_allowlist",
    "retention_class",
    "consent_rule",
    "status"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "purpose": {
      "type": "string",
      "enum": [
        "product_improvement",
        "onboarding_effectiveness",
        "commercial_funnel"
      ]
    },
    "trigger": {
      "type": "string",
      "enum": [
        "server_action_accepted",
        "server_commit_succeeded",
        "server_terminal_failure",
        "authorized_server_read",
        "reconciled_subscription_transition"
      ]
    },
    "actor_scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "anonymous",
          "authenticated",
          "organization_context"
        ]
      }
    },
    "metadata_allowlist": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "actor_class",
          "execution_mode",
          "result_class",
          "failure_class",
          "report_age_class",
          "visibility_class",
          "invitation_role_class",
          "quota_action",
          "commercial_stage",
          "cadence_class"
        ]
      }
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "analytics_short",
        "analytics_standard"
      ]
    },
    "consent_rule": {
      "type": "string",
      "enum": [
        "approved_current_purpose_decision_required"
      ]
    },
    "status": {
      "type": "string",
      "const": "candidate"
    }
  }
}
