APP_ENV=development
APP_NAME=DeFi Thesis & Risk Copilot
PUBLIC_DEMO_MODE=false
APP_VERSION=1.0.0
DEPLOYMENT_COMMIT=
OBSERVABILITY_ENABLED=false
OBSERVABILITY_RELEASE_ID=
OBSERVABILITY_SAMPLING_RATE=1.0
OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=2
OBSERVABILITY_EXPORT_QUEUE_SIZE=100
OBSERVABILITY_CLOCK_TIMEZONE=UTC
# Phase 19D local aggregate monitoring; no exporter, pager, or synthetic run is
# enabled by default. Authenticated synthetics use an operator-only environment token.
OPERATIONS_MONITORING_ENABLED=false
OPERATIONS_ALERT_EVALUATION_ENABLED=false
OPERATIONS_SYNTHETIC_CHECKS_ENABLED=false
OPERATIONS_SYNTHETIC_ALLOWED_ORIGINS=
OPERATIONS_MONITORING_WINDOW_HOURS=24
OPERATIONS_MONITORING_EVENT_LIMIT=1000
OPERATIONS_ALERT_QUEUE_DEPTH=25
OPERATIONS_ALERT_QUEUE_AGE_SECONDS=900
OPERATIONS_ALERT_DEAD_LETTER_COUNT=1
OPERATIONS_ALERT_STALE_WORKER_COUNT=1
OPERATIONS_ALERT_RETRIEVAL_EMPTY_RATE_PERCENT=80
OPERATIONS_ALERT_RETRIEVAL_LATENCY_MS=5000
# Phase 19H synthetic failure exercises. Keep disabled outside an explicitly
# isolated local/CI database; the runner refuses production and real Vast mode.
OPERATIONS_EXERCISES_ENABLED=false
OPERATIONS_EXERCISES_ISOLATED=false
OPERATIONS_EXERCISE_TIMEOUT_SECONDS=180
# Phase 19I durable-RAG rollout evidence. The checker is read-only and refuses
# an isolated primary-path check unless both values are explicitly enabled.
CONTROLLED_RAG_VALIDATION_ENABLED=false
CONTROLLED_RAG_VALIDATION_ISOLATED=false
# Phase 19E recovery controls. Keep disabled until an operator records a
# provider backup/restore drill; the reference is an identifier, never a secret.
BACKUP_RESTORE_DRILL_ENABLED=false
BACKUP_RETENTION_GUARD_ENABLED=false
BACKUP_RESTORE_EVIDENCE_REFERENCE=
BACKUP_RPO_HOURS=24
BACKUP_RTO_MINUTES=240
PUBLIC_COMPUTE_RATE_LIMIT_PER_MINUTE=20
RATE_LIMITING_ENABLED=false
RATE_LIMITING_MODE=shadow
RATE_LIMIT_KEY_PEPPER=
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
RATE_LIMIT_RETENTION_SECONDS=86400
RATE_LIMIT_PUBLIC_COMPUTE_BURST_LIMIT=20
RATE_LIMIT_PUBLIC_COMPUTE_BURST_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_COMPUTE_SUSTAINED_LIMIT=120
RATE_LIMIT_PUBLIC_COMPUTE_SUSTAINED_WINDOW_SECONDS=3600
RATE_LIMIT_AUTHENTICATED_COMPUTE_BURST_LIMIT=60
RATE_LIMIT_AUTHENTICATED_COMPUTE_BURST_WINDOW_SECONDS=60
RATE_LIMIT_AUTHENTICATED_COMPUTE_SUSTAINED_LIMIT=1000
RATE_LIMIT_AUTHENTICATED_COMPUTE_SUSTAINED_WINDOW_SECONDS=3600
RATE_LIMIT_JOB_SUBMIT_BURST_LIMIT=10
RATE_LIMIT_JOB_SUBMIT_BURST_WINDOW_SECONDS=60
RATE_LIMIT_JOB_SUBMIT_SUSTAINED_LIMIT=100
RATE_LIMIT_JOB_SUBMIT_SUSTAINED_WINDOW_SECONDS=3600
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:3000
BFF_ALLOWED_ORIGINS=http://127.0.0.1:3000
API_MAX_REQUEST_BYTES=1048576
BFF_MAX_REQUEST_BYTES=1048576
BFF_KNOWLEDGE_UPLOAD_MAX_BYTES=10616832
SECURITY_CSP_MODE=report_only
SECURITY_CSP_REPORT_URI=
SECURITY_HSTS_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
BACKEND_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PUBLIC_DEMO_MODE=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/defi_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=defi_copilot
POSTGRES_HOST_PORT=5435
LLM_SYNTHESIS_ENABLED=false
LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8
DEFILLAMA_BASE_URL=https://api.llama.fi
RAG_SEMANTIC_ENABLED=false
RAG_EMBEDDING_PROVIDER=local_semantic
RAG_HYBRID_KEYWORD_WEIGHT=0.45
RAG_HYBRID_VECTOR_WEIGHT=0.45
RAG_HYBRID_METADATA_WEIGHT=0.10
AUTH_ENABLED=false
AUTH_PROVIDER=legacy_local
REQUIRE_VERIFIED_EMAIL=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
KNOWLEDGE_STORAGE_ENABLED=false
SUPABASE_STORAGE_BUCKET=private-knowledge
SUPABASE_STORAGE_TIMEOUT_SECONDS=20
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760
KNOWLEDGE_UPLOAD_CHUNK_BYTES=65536
# Private knowledge remains disabled. When it is deliberately enabled in
# production, a trusted scanner endpoint is required and failures reject uploads.
KNOWLEDGE_UPLOAD_SCANNING_REQUIRED=false
KNOWLEDGE_UPLOAD_SCANNER_URL=
KNOWLEDGE_UPLOAD_SCANNER_TIMEOUT_SECONDS=10
DOCUMENT_INGEST_ENABLED=false
KNOWLEDGE_INGEST_MAX_BYTES=10485760
KNOWLEDGE_INGEST_MAX_TEXT_BYTES=2097152
KNOWLEDGE_INGEST_MAX_PDF_PAGES=100
KNOWLEDGE_CHUNK_MAX_CHARACTERS=2000
KNOWLEDGE_EMBEDDINGS_ENABLED=false
KNOWLEDGE_EMBEDDING_PROFILE_ID=kembprof_local_hash_384_v1
KNOWLEDGE_EMBEDDING_PROVIDER=local_deterministic
KNOWLEDGE_EMBEDDING_MODEL=local-hash-384-v1
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
KNOWLEDGE_SHADOW_RETRIEVAL_ENABLED=false
KNOWLEDGE_SHADOW_RETRIEVAL_TOP_K=4
# Operator-only migration of repository Markdown; never enable in a browser path.
KNOWLEDGE_PUBLIC_CORPUS_IMPORT_ENABLED=false
# Requires a validated shadow period. It is prohibited in APP_ENV=production;
# isolated staging-only primary checks need CONTROLLED_RAG_VALIDATION_ISOLATED.
# Authenticated analysis derives tenant scope server-side; anonymous analysis
# remains public-only and JSON stays the fallback.
KNOWLEDGE_PGVECTOR_PRIMARY_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SESSION_COOKIE_NAME=defi_copilot_session
ANONYMOUS_SESSION_COOKIE_NAME=defi_copilot_anon
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ADMIN_MFA_REQUIRED=false
ANONYMOUS_RETENTION_HOURS=24
DELETED_ACCOUNT_RETENTION_DAYS=30
CURRENT_TERMS_VERSION=2026-07-20
CURRENT_PRIVACY_VERSION=2026-07-20
DEFAULT_USER_PLAN=free
QUOTA_ANONYMOUS_ANALYSES_PER_DAY=5
QUOTA_FREE_ANALYSES_PER_DAY=25
QUOTA_FREE_SIMULATIONS_PER_DAY=100
QUOTA_FREE_OPTIONS_PER_DAY=100
QUOTA_FREE_MARKET_DATA_PER_DAY=100
QUOTA_FREE_SAVED_THESES=50
QUOTA_FREE_WATCHLISTS=25
QUOTA_ADMIN_EXEMPT=true
ADMIN_EMAIL=admin@example.local
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_PASSWORD=
AUTH_SECRET_KEY=
BFF_AUDIT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
VAST_ENABLED=false
VAST_API_BASE_URL=https://console.vast.ai/api/v0
VAST_API_KEY=
VAST_CREDENTIAL_NAME=vast_ai_default
VAST_MAX_HOURLY_COST_USD=0.50
VAST_MAX_SESSION_MINUTES=30
VAST_MAX_ACTIVE_INSTANCES=1
VAST_GPU_ALLOWLIST=RTX_4090,RTX_3090,A5000,A6000
VAST_MIN_GPU_RAM_GB=16
VAST_DISK_GB=40
VAST_REQUIRE_VERIFIED=true
VAST_AUTO_DESTROY=true
VAST_IDLE_TIMEOUT_SECONDS=300
VAST_IMAGE=
VAST_MODEL=
VAST_CONTAINER_PORT=8000
VAST_STARTUP_TIMEOUT_SECONDS=600
VAST_POLL_INTERVAL_SECONDS=10
VAST_DRY_RUN=true
VAST_REAL_RENTALS_ENABLED=false
# `verified_v1` is intentionally unavailable until real provider reconciliation is independently validated.
VAST_RECONCILIATION_PROFILE=unverified
JOBS_ENABLED=false
WORKER_API_ENABLED=false
ASYNC_ANALYSIS_ENABLED=false
VAST_JOB_ENABLED=false
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_LEASE_EXTENSION_SECONDS=720
ANALYSIS_JOB_MAX_ATTEMPT_RUNTIME_SECONDS=300
JOB_CLEANUP_GRACE_SECONDS=60
VAST_RECONCILIATION_GRACE_SECONDS=30
# A claim may never extend beyond this fixed per-attempt horizon. Keep jobs disabled unless a
# trusted worker and scheduled `scripts.recover_durable_jobs` operations runbook exist.
JOB_MAX_QUEUE_AGE_SECONDS=3600
JOB_EVENT_RETENTION_DAYS=90
JOB_TERMINAL_RETENTION_DAYS=30
# Manual Phase 17 retention uses these windows until a later durable scheduler is approved.
JOB_MAX_INPUT_BYTES=65536
JOB_MAX_RESULT_BYTES=262144
JOB_MAX_PROGRESS_MESSAGE_LENGTH=512
JOB_GLOBAL_PENDING_LIMIT=100
JOB_GLOBAL_RUNNING_LIMIT=4
JOB_USER_PENDING_LIMIT=10
JOB_USER_RUNNING_LIMIT=2
JOB_ORG_PENDING_LIMIT=50
JOB_ORG_RUNNING_LIMIT=8
JOB_PROVIDER_PENDING_LIMIT=25
JOB_PROVIDER_RUNNING_LIMIT=4
JOB_DAILY_COST_BUDGET_MICROUSD=0
JOB_CLAIM_SCAN_LIMIT=25
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
WORKER_STALE_SECONDS=120
WORKER_POLL_SECONDS=2
WORKER_PROTOCOL_VERSION=v1
WORKER_TOKEN_PEPPER=
